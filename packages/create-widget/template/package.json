    "@merkur/plugin-error": "^3.0.0",
    "@merkur/plugin-event-emitter": "^3.0.0",
    "compression": "^1.8.1",
    "config": "^3.3.12",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-static-gzip": "^2.2.0",
    "helmet": "^5.1.1",
